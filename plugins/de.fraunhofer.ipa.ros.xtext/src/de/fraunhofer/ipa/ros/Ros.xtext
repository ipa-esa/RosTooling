///////////////////
//OBJECTS/SPECIFICATIONS
///////////////////

TopicSpec returns TopicSpec:
    {TopicSpec}
    name=(EString|'Header'|'String')
    BEGIN
        'message' (BEGIN message=MessageDefinition END)?
    END
    ;

ServiceSpec returns ServiceSpec:
    {ServiceSpec}
    name=EString
    BEGIN
        'request' (BEGIN request=MessageDefinition END)?
        'response' (BEGIN response=MessageDefinition END)?
    END;

ActionSpec returns ActionSpec:
    {ActionSpec}
    name=EString
    BEGIN
        'goal' (BEGIN goal=MessageDefinition END)?
        'result' (BEGIN result=MessageDefinition END)?
        'feedback' (BEGIN feedback=MessageDefinition END)?
    END;


MessageDefinition returns MessageDefinition:
    {MessageDefinition}
        MessagePart+=MessagePart*;

///////////////////
//ARTIFACT, NODE AND PLUGINS
///////////////////
Artifact returns Artifact:
    {Artifact}
        name=RosNames':'
        BEGIN
        (node=Node)?
        ('plugins:'
            BEGIN
            plugins+=Plugin*
            END
        )?
        END;

Node returns Node:
    'node:' name=RosNames
    (
    ('publishers:'
        BEGIN
        publisher+=Publisher*
        END
    )|
    ('subscribers:'
        BEGIN
        subscriber+=Subscriber*
        END
    )|
    ('serviceservers:'
        BEGIN
        serviceserver+=ServiceServer*
        END
    )|
    ('serviceclients:'
        BEGIN
        serviceclient+=ServiceClient*
        END
    )|
    ('actionservers:'
        BEGIN
        actionserver+=ActionServer*
        END
    )|
    ('actionclients:'
        BEGIN
        actionclient+=ActionClient*
        END
    )|
    ('parameters:'
        BEGIN
        parameter+=Parameter*
        END
    )|
    ('pluginslots:'
        BEGIN
        pluginSlots+=PluginSlot*
        END
    )|
    (extensions+=ExtensionBlock)
    )*
    ;

enum PluginLoader returns PluginLoader:
    PLUGINLIB = 'pluginlib' |
    EXTERNAL = 'external'
;

enum PluginSlotValueFormat returns PluginSlotValueFormat:
    CLASS = 'class' |
    LIBRARY = 'library'
;

Plugin returns Plugin:
    {Plugin}
    name=RosNames':'
    BEGIN
    (
    ('implements:' implements=EString)|
    ('loader:' loader=PluginLoader)|
    ('publishers:'
        BEGIN
        publisher+=Publisher*
        END
    )|
    ('subscribers:'
        BEGIN
        subscriber+=Subscriber*
        END
    )|
    ('serviceservers:'
        BEGIN
        serviceserver+=ServiceServer*
        END
    )|
    ('serviceclients:'
        BEGIN
        serviceclient+=ServiceClient*
        END
    )|
    ('actionservers:'
        BEGIN
        actionserver+=ActionServer*
        END
    )|
    ('actionclients:'
        BEGIN
        actionclient+=ActionClient*
        END
    )|
    ('parameters:'
        BEGIN
        parameter+=Parameter*
        END
    )|
    (extensions+=ExtensionBlock)
    )*
    END;

PluginSlot returns PluginSlot:
    {PluginSlot}
    name=EString':'
    (
    (BEGIN
        (('base:' base=EString) &
         ('parameter:' parameter=EString) &
         ('format:' valueFormat=PluginSlotValueFormat)? &
         ('default:' defaultPlugin=EString)?)
    END) |
    ('{'
        'base:' base=EString
        ','? 'parameter:' parameter=EString
        (','? 'format:' valueFormat=PluginSlotValueFormat)?
        (','? 'default:' defaultPlugin=EString)?
    '}')
    );

@Override
EString returns ecore::EString:
    STRING | ID | 'pluginlib' | 'external' | 'class' | 'library';

@Override
RosNames returns ecore::EString:
    ROS_CONVENTION_A | ID | 'node' | 'pluginlib' | 'external' | 'class' | 'library';

@Override
ExtensionKey returns ecore::EString:
    ID | STRING | KEYWORD | 'node' | 'pluginlib' | 'external' | 'class' | 'library' |
    'String' | 'Integer' | 'Double' | 'Boolean' | 'Base64' | 'Array' | 'List' | 'Struct' | 'Date' | 'Any' |
    'bool' | 'int8' | 'uint8' | 'int16' | 'uint16' | 'int32' | 'uint32' | 'int64' | 'uint64' | 'float32' | 'float64' | 'string' | 'char' | 'byte' | 'Header';

@Override
ExtensionColonKey returns ecore::EString:
    'ns:' | 'type:' | 'value:' | 'default:' |
    'fromGitRepo:' | 'dependencies:' | 'msgs:' | 'srvs:' | 'actions:' |
    'node:' | 'publishers:' | 'subscribers:' | 'serviceservers:' | 'serviceclients:' |
    'actionservers:' | 'actionclients:' | 'parameters:' |
    'plugins:' | 'implements:' | 'loader:' | 'pluginslots:' | 'base:' | 'parameter:' | 'format:';

///////////////////
//INTERFACES
///////////////////
Publisher returns Publisher:
    {Publisher}
        name=EString':'
        BEGIN
            'type:' message=[TopicSpec|EString]
            ('ns:' namespace=Namespace)?
        END
    ;

Subscriber returns Subscriber:
    {Subscriber}
        name=EString':'
        BEGIN
            'type:' message=[TopicSpec|EString]
            ('ns:' namespace=Namespace)?
        END
    ;

ServiceServer returns ServiceServer:
    {ServiceServer}
        name=EString':'
        BEGIN
            'type:' service=[ServiceSpec|EString]
            ('ns:' namespace=Namespace)?
        END
    ;

ServiceClient returns ServiceClient:
    {ServiceClient}
        name=EString':'
        BEGIN
            'type:' service=[ServiceSpec|EString]
            ('ns:' namespace=Namespace)?
        END
    ;

ActionServer returns ActionServer:
    {ActionServer}
        name=EString':'
        BEGIN
            'type:' action=[ActionSpec|EString]
            ('ns:' namespace=Namespace)?
        END
    ;

ActionClient returns ActionClient:
    {ActionClient}
        name=EString':'
        BEGIN
            'type:' action=[ActionSpec|EString]
            ('ns:' namespace=Namespace)?
        END
